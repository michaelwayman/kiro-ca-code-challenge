# Copy to .env and adjust if needed. Defaults work for the challenge out of the box.

MYSQL_ROOT_PASSWORD=root
WORDPRESS_DB_NAME=wp
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=wp
WORDPRESS_TABLE_PREFIX=wp_

# Seeded admin credentials (informational — re-run scripts/seed.sh to recreate)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE="Brand Reviews Challenge"

# ---------------------------------------------------------------------------
# Django services: main app (:8000) and auth service (:8001)
# Local-development defaults only. No real secrets belong in this file.
#
# DJANGO_DEBUG is intentionally NOT set here: the compose files own it
# ("0" in docker-compose.yml, "1" in docker-compose.override.yml; D-033).
# The WP source DB settings for the importers (WP_DB_*) are derived in compose
# from the WORDPRESS_DB_* values above.
# ---------------------------------------------------------------------------

# Refused at startup when DEBUG is off (Req 10.4). `make up-prod` supplies a random one.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,main,auth

# Postgres: one database per service (D-002). Compose builds MAIN_DATABASE_URL /
# AUTH_DATABASE_URL from these, so each password lives in one place.
MAIN_DB_NAME=main
MAIN_DB_USER=main
MAIN_DB_PASSWORD=main
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth

# Tokens (D-004, D-031, D-034). Issuer/audience must match in both services.
AUTH_ISSUER=brand-reviews-auth
AUTH_AUDIENCE=brand-reviews-api
AUTH_SIGNING_KEY_PATH=/run/keys/signing.pem
AUTH_ACCESS_TTL_SECONDS=600
AUTH_REFRESH_TTL_SECONDS=604800

# Main app → auth service JWKS (design §4.3)
AUTH_JWKS_URL=http://auth:8000/.well-known/jwks.json
AUTH_JWKS_FRESH_TTL=300
AUTH_JWKS_MAX_STALE=3600
AUTH_JWKS_REFETCH_MIN_INTERVAL=30

# Dev only: point templates at the Vite dev server instead of built assets (design §7).
# Example: VITE_DEV_SERVER=http://localhost:5173
VITE_DEV_SERVER=
